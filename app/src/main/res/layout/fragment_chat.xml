<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/friends_background"
    tools:context=".View.ChatFragment">


    <TextView
        android:id="@+id/tv_chat_between_who"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:background="#232A2E"
        android:textColor="@color/white"
        android:textAlignment="center"
        android:paddingTop="60dp"
        android:paddingBottom="20dp"
        android:textSize="25sp"
        android:text="@string/chat_between_you_and_your_friend"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="120dp"
        app:layout_constraintBottom_toTopOf="@+id/et_message"
        app:layout_constraintTop_toTopOf="@id/tv_chat_between_who"
        tools:layout_editor_absoluteX="0dp"
        android:layout_marginBottom="20dp"
        tools:listitem="@layout/chat_item" />

    <EditText
        android:id="@+id/et_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="10dp"
        android:background="#F6F6F6"
        android:padding="10dp"
        android:ems="10"
        android:hint="@string/message"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@+id/btn_send"
        tools:layout_editor_absoluteX="0dp" />

    <Button
        android:id="@+id/btn_send"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_marginHorizontal="10dp"
        android:backgroundTint="#232A2E"
        android:text="@string/send"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>